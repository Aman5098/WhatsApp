PORT=4100

# Inbound media above this size is announced on wa:message but not attached
# (media: null, mediaError: "too_large"). Default 16.
MAX_INBOUND_MEDIA_MB=16

# How long an unscanned QR code is kept alive before the gateway gives up
# and tears the session down on its own (status -> "expired"), so someone
# who asked for a QR and never scanned it doesn't hold a Chromium instance
# (and an endlessly-rotating QR push) open forever. Default 120.
QR_EXPIRY_SECONDS=120

# Backward-compat only: if projects.json does not exist, a single legacy
# project named "default" is created using this secret. Once you add
# projects.json (see projects.json.example), this is ignored — manage
# per-project API keys there instead.
GATEWAY_SHARED_SECRET=change-me

# Optional — path to a Chrome/Chromium binary for whatsapp-web.js. When
# unset, the gateway auto-detects an installed Chrome (see
# src/puppeteerLaunchOptions.js).
PUPPETEER_EXECUTABLE_PATH=

# Optional — where session data (LocalAuth) and tenant ownership claims are
# stored. Both must persist across restarts; point them at a mounted volume
# in containers. Default: .wwebjs_auth/ and .tenant-ownership.json in this folder.
WWEBJS_AUTH_PATH=
TENANT_OWNERSHIP_FILE=


PROJECTS_FILE=/etc/secrets/projects.json
