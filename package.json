{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Shared whatsapp-web.js/Puppeteer session manager for multiple projects. Pushes events over Socket.IO and exposes an HTTP API (sends, chats, media, control).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "patch-package": "^8.0.1"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      ".wwebjs_auth/**",
      ".wwebjs_cache/**"
    ]
  }
}
